
record User {
    uuid: UUID;
    username: string;
    verified: bool;
}

enum AuthError {
  USERNAME_MALFORMED,
  WEAK_PASSWORD,
  INVALID_CREDENTIALS,
  USERNAME_ALREADY_EXISTS,
  TOKEN_EXPIRED,
  UNAUTHORIZED,
}

record AuthSuccess {
    userId: UUID;
    accessToken: string;
    refreshToken: string;
    expiresAt: float;
}

service auth {
    mutation signin(username: string, password: string): AuthSuccess|AuthError;
    mutation signup(username: string, password: string): AuthSuccess|AuthError;
    mutation refresh(refreshToken: string): AuthSuccess|AuthError;
    mutation logout(refreshToken: string): empty;
}

service user {
    query get(): User;
}

