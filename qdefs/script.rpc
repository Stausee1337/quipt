
record Script {
    uuid: UUID;
    name: string;
    createdAt: float;
    divisions: Division[];
}

// FIXME: Division -> Section
record Division {
    name: string;
    description: string;
    textCues: TextCuePair[];
    previousTotals: uint[];
}

record TextCuePair {
    request: TextCue?;
    response: TextCue;
    previousScores: uint[];
}

record TextCue {
    actors: string[];
    text: string;
}

service script {
    query list(): Script[];
    query get(uuid: UUID): Script;

    mutation create(script: Script): UUID;
    mutation rename(uuid: UUID, name: string): empty;
    mutation delete(uuid: UUID): empty;
}

service division {
    mutation saveScores(
        scriptId: UUID,
        divisionIdx: uint,
        newScores: uint[],
    ): empty;

    mutation updateDescription(
        scriptId: UUID,
        divisionIdx: uint,
        description: string
    ): empty;

    mutation rename(
        scriptId: UUID,
        divisionIdx: uint,
        name: string
    ): empty;
}

service cue {
    mutation insert(
        uuid: UUID,
        divisionIdx: uint,
        cueIdx: uint,
        cue: TextCuePair
    ): empty;

    mutation update(
        uuid: UUID,
        divisionIdx: uint,
        cueIdx: uint,
        newCue: TextCuePair
    ): empty;

    mutation delete(
        uuid: UUID,
        divisionIdx: uint,
        cueIdx: uint
    ): empty;
}

