
record Script {
    uuid: UUID;
    name: string;
    createdAt: float;
    divisions: Division[];
}

record Division {
    name: string;
    description: string;
    textCues: TextCuePair[];
    previousTotals: uint[];
}

record TextCuePair {
    request: TextCue?;
    response: TextCue;
    previousScores: uint[];
}

record TextCue {
    actors: string[];
    text: string;
}

service script {
    query list(): Script[];
    query get(uuid: UUID): Script;
    mutation saveScores(
        scriptId: UUID,
        divisionIdx: uint,
        newScores: uint[],
    ): empty;
    mutation rename(uuid: UUID, name: string): empty;
    mutation create(script: Script): UUID;
    mutation delete(uuid: UUID): empty;

    mutation insertCue(
        uuid: UUID,
        divisionIdx: uint,
        cueIdx: uint,
        cue: TextCuePair
    ): empty;

    mutation updateCue(
        uuid: UUID,
        divisionIdx: uint,
        cueIdx: uint,
        newCue: TextCuePair
    ): empty;

    mutation deleteCue(
        uuid: UUID,
        divisionIdx: uint,
        cueIdx: uint
    ): empty;
}

